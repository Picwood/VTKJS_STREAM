import { readFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import playwrightTest from '../../src/client/node_modules/@playwright/test/index.js';
const { test, expect } = playwrightTest;
const fixtures = fileURLToPath(new URL('../../../../portable/tests/fixtures/calculix/', import.meta.url));

test('prepare a model, download input and inspect external results in the browser', async ({ page }, testInfo) => {
  const errors: string[] = [];
  page.on('pageerror', error => errors.push(error.message));
  await page.goto('/');
  await expect(page.locator('#web-status')).toContainText('Workspace ready');
  await page.getByRole('button', { name: 'Open / import', exact: true }).click();
  const cube = (await readFile(fixtures + 'cube.inp', 'utf8')).split('*MATERIAL')[0]!;
  await page.locator('#import-file').setInputFiles({ name: 'cube-mesh.inp', mimeType: 'application/octet-stream', buffer: Buffer.from(cube) });
  await page.locator('#import-e').fill('1000');
  await page.locator('#import-nu').fill('0');
  await page.getByRole('button', { name: 'Open in workspace', exact: true }).click();
  await expect(page.locator('#web-status')).toContainText('Project opened');
  await expect(page.locator('#web-viewport canvas')).toHaveCount(1);
  await expect(page.locator('#scene-counts')).toContainText('8 points');
  await page.locator('#model-tree').getByRole('button', { name: 'ELASTIC', exact: true }).click();
  await expect(page.locator('#edit-action')).toHaveValue('material-save');
  await page.locator('#editor-fields input[name=e]').fill('2000');
  const commandResponse = page.waitForResponse(response => response.url().endsWith('/api/workspace/commands/material'));
  await page.getByRole('button', { name: 'Apply to model', exact: true }).click();
  const command = await (await commandResponse).json();
  expect(command.receipt.kind).toBe('material.elastic.patch/1');
  expect(command.receipt.sourceRevision).toBe(1);
  expect(command.receipt.committedRevision).toBe(2);
  await expect(page.locator('#web-status')).toContainText('Saved model revision 2');
  const materialId = command.receipt.materialId;
  await page.locator('#edit-action').selectOption('material-rename');
  await page.locator('#editor-fields input[name=newName]').fill('Browser-alloy');
  const renameResponse = page.waitForResponse(response => response.url().endsWith('/api/workspace/commands/material/rename'));
  await page.getByRole('button', { name: 'Apply to model', exact: true }).click();
  const rename = await (await renameResponse).json();
  expect(rename.receipt.materialId).toBe(materialId);
  await expect(page.locator('#web-status')).toContainText('Saved model revision 3');
  await expect(page.locator('#model-tree').getByRole('button', { name: 'Browser-alloy', exact: true })).toBeVisible();
  const downloadPromise = page.waitForEvent('download');
  await page.getByRole('button', { name: 'Export CalculiX input' }).click();
  const download = await downloadPromise;
  expect(download.suggestedFilename()).toBe('analysis-r3.inp');
  const deck = await readFile((await download.path())!, 'utf8');
  expect(deck).toContain('2000');
  expect(deck).toContain('Material=Browser-alloy');
  await page.getByRole('button', { name: '02 Results', exact: true }).click();
  await page.locator('#result-file').setInputFiles(fixtures + 'cube.frd');
  await expect(page.locator('#web-status')).toContainText('External results attached');
  const field = await page.locator('#result-field option').filter({ hasText: 'DISP · U1' }).first().getAttribute('value');
  expect(field).not.toBeNull();
  await page.locator('#result-field').selectOption(field!);
  await page.locator('#deformation').fill('100');
  await page.getByRole('button', { name: 'Display selected field' }).click();
  await expect(page.locator('#web-status')).toHaveText('Result field displayed.');
  await expect(page.locator('#field-summary')).toContainText('0.0010000');
  await expect(page.locator('.scalar-legend')).toBeVisible();
  await page.locator('#camera').selectOption('front');
  await page.locator('#scalar-colors').uncheck();
  await expect(page.locator('.scalar-legend')).toBeHidden();
  await page.locator('#scalar-colors').check();
  await expect(page.locator('.scalar-legend')).toBeVisible();
  await page.getByRole('button', { name: 'Fit model', exact: true }).click();
  await page.screenshot({ path: '/tmp/prepomax-web-workspace.png' });
  await testInfo.attach('web-results-workspace', { body: await page.screenshot(), contentType: 'image/png' });
  await page.setViewportSize({ width: 390, height: 844 });
  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);
  await expect(page.locator('#web-error')).toBeHidden();
  expect(errors).toEqual([]);
});

test('create, assign and remove an unused material through shared commands', async ({ page }) => {
  await page.goto('/');
  await expect(page.locator('#web-status')).toContainText('Workspace ready');
  await page.getByRole('button', { name: 'Open / import', exact: true }).click();
  const cube = (await readFile(fixtures + 'cube.inp', 'utf8')).split('*MATERIAL')[0]!;
  await page.locator('#import-file').setInputFiles({ name: 'cube.inp', mimeType: 'application/octet-stream', buffer: Buffer.from(cube) });
  await page.locator('#import-e').fill('1000');
  await page.locator('#import-nu').fill('0');
  await page.getByRole('button', { name: 'Open in workspace', exact: true }).click();
  await expect(page.locator('#web-status')).toContainText('Project opened');
  await page.locator('#edit-action').selectOption('material-add');
  await page.locator('#editor-fields input[name=name]').fill('Browser-new');
  await page.locator('#editor-fields input[name=e]').fill('500');
  await page.locator('#editor-fields input[name=nu]').fill('.2');
  const createResponse = page.waitForResponse(response => response.url().endsWith('/api/workspace/commands/material/create'));
  await page.getByRole('button', { name: 'Apply to model', exact: true }).click();
  const created = await (await createResponse).json();
  expect(created.receipt.kind).toBe('material.elastic.create/1');
  await expect(page.locator('#web-status')).toContainText('Saved model revision 2');
  await expect(page.locator('#model-tree').getByRole('button', { name: 'Browser-new', exact: true })).toBeVisible();
  await page.locator('#edit-action').selectOption('section-assign');
  await page.locator('#editor-fields select[name=region]').selectOption('Browser-new');
  const assignResponse = page.waitForResponse(response => response.url().endsWith('/api/workspace/commands/material/assign'));
  await page.getByRole('button', { name: 'Apply to model', exact: true }).click();
  const assigned = await (await assignResponse).json();
  expect(assigned.receipt.materialId).toBe(created.receipt.materialId);
  await expect(page.locator('#web-status')).toContainText('Saved model revision 3');
  await page.locator('#edit-action').selectOption('material-remove');
  await expect(page.locator('#editor-fields select[name=name] option[value="Browser-new"]')).toHaveCount(0);
  await page.locator('#edit-action').selectOption('section-assign');
  await page.locator('#editor-fields select[name=region]').selectOption('ELASTIC');
  await page.getByRole('button', { name: 'Apply to model', exact: true }).click();
  await expect(page.locator('#web-status')).toContainText('Saved model revision 4');
  await page.locator('#edit-action').selectOption('material-remove');
  await page.locator('#editor-fields select[name=name]').selectOption('Browser-new');
  const removeResponse = page.waitForResponse(response => response.url().endsWith('/api/workspace/commands/material/remove'));
  await page.getByRole('button', { name: 'Apply to model', exact: true }).click();
  const removed = await (await removeResponse).json();
  expect(removed.receipt.kind).toBe('material.remove-unused/1');
  expect(removed.receipt.materialId).toBe(created.receipt.materialId);
  await expect(page.locator('#web-status')).toContainText('Saved model revision 5');
  await expect(page.locator('#model-tree').getByRole('button', { name: 'Browser-new', exact: true })).toHaveCount(0);
  await page.locator('#undo').click();
  await expect(page.locator('#web-status')).toContainText('Restored project revision 6');
  const restored = await (await page.request.get('/api/workspace')).json();
  expect(restored.materialIdentities.find((item: { name: string }) => item.name === 'Browser-new').id).toBe(created.receipt.materialId);
  await page.locator('#redo').click();
  await expect(page.locator('#web-status')).toContainText('Restored project revision 7');
  await expect(page.locator('#model-tree').getByRole('button', { name: 'Browser-new', exact: true })).toHaveCount(0);
  await expect(page.locator('#web-error')).toBeHidden();
});
