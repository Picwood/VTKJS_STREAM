    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ncalc" Version="1.3.8" />
    <PackageReference Include="UnitsNet" Version="4.89.1" />
    <Compile Include="../../../CaeGlobals/NCalc/MyNCalc.cs" />
    <Compile Include="../../../CaeGlobals/CommonClasses/OrderedDictionary.cs" />
    <Compile Include="../../../CaeGlobals/CaeException.cs" />
    <Compile Include="../CaeGlobals.Characterization/EquationChecks.cs" />
  </ItemGroup>
</Project>
