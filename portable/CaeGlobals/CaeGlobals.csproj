    <Compile Include="../../CaeGlobals/CommonClasses/DataExchange/*.cs" Link="CommonClasses/DataExchange/%(Filename)%(Extension)" />
    <Compile Include="../../CaeGlobals/Comparers/*.cs" Link="Comparers/%(Filename)%(Extension)" />
