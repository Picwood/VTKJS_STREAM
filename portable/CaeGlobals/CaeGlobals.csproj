    <Compile Include="../../CaeGlobals/CommonClasses/Geometry.cs" Link="CommonClasses/Geometry.cs" />
    <Compile Include="../../CaeGlobals/CommonClasses/Geometry2.cs" Link="CommonClasses/Geometry2.cs" />
    <Compile Include="../../CaeGlobals/CommonClasses/Matrix.cs" Link="CommonClasses/Matrix.cs" />
